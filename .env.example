# Khóa OpenAI (bắt buộc). Không có chế độ giả lập: thiếu khóa thì app báo lỗi rõ ràng.
OPENAI_API_KEY=
# Model PHẢI pin theo snapshot có ngày (tên không ngày như "gpt-4.1" là model sống, OpenAI có thể đổi hành vi bất cứ lúc nào).
# Nâng version: đổi giá trị dưới đây, chạy `npm run eval` và so với evals/baseline.json, chỉ merge khi điểm không giảm.
OPENAI_CHAT_MODEL=gpt-4.1-2025-04-14
OPENAI_FAST_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase Postgres (Project Settings > Database > Connection string > Session pooler, cổng 5432)
DATABASE_URL="postgresql://postgres.<ref>:<mat-khau>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Tùy chọn: DB riêng cho test / e2e. Để trống thì test dùng DATABASE_URL (chỉ tạo/xóa schema t_*).
TEST_DATABASE_URL=""
E2E_DATABASE_URL=""

# Khóa ký cookie phiên đăng nhập demo (tối thiểu 32 ký tự; tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
SESSION_SECRET=thay-the-bang-khoa-ngau-nhien-it-nhat-32-ky-tu-tro-len

# Hiện nút "Thử xem hồ sơ bé khác" trên giao diện phụ huynh (tắt khi chạy thật)
NEXT_PUBLIC_DEMO_MODE=true

# Bí mật cho cron health check model (Vercel tự gửi "Authorization: Bearer <giá trị này>"). Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Để trống thì endpoint /api/v1/cron/model-health bị tắt (trả 503).
CRON_SECRET=

# Gửi email cho phụ huynh (tuỳ chọn). Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=truong@gmail.com
# SMTP_PASS=
# SMTP_FROM=Trường mầm non Hoa Mai <truong@gmail.com>
