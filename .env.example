# Khóa OpenAI (bắt buộc). Không có chế độ giả lập: thiếu khóa thì app báo lỗi rõ ràng.
OPENAI_API_KEY=
# Model PHẢI pin theo snapshot có ngày (tên không ngày như "gpt-4.1" là model sống, OpenAI có thể đổi hành vi bất cứ lúc nào).
# Nâng version: đổi giá trị dưới đây, chạy `npm run eval` và so với evals/baseline.json, chỉ merge khi điểm không giảm.
OPENAI_CHAT_MODEL=gpt-4.1-2025-04-14
OPENAI_FAST_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SQLite cho prototype (đổi sang Postgres khi lên production)
DATABASE_URL="file:./dev.db"

# Khóa ký cookie phiên đăng nhập demo (tối thiểu 32 ký tự; tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
SESSION_SECRET=thay-the-bang-khoa-ngau-nhien-it-nhat-32-ky-tu-tro-len

# Hiện nút "Thử xem hồ sơ bé khác" trên giao diện phụ huynh (tắt khi chạy thật)
NEXT_PUBLIC_DEMO_MODE=true
