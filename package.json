    "ai": "^5.0.281",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "langchain": "^1.5.19",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "prisma": "^7.10.1",
    "react": "19.3.0",
